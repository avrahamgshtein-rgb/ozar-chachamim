#!/usr/bin/env bash
#
# Pre-commit hook: validate data and graph integrity
# Runs audit to detect data issues. Pre-existing drift is informational.
# Only blocks commits that INTRODUCE new data issues.
#

set -o pipefail

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check if any data files are being modified
DATA_FILES_MODIFIED=$(echo "$STAGED_FILES" | grep -E "(data\.json|data-.*\.json|public/data.*)" || true)

if [ -z "$DATA_FILES_MODIFIED" ]; then
  # No data files modified, hook passes
  exit 0
fi

# Run audit
cd "$(git rev-parse --show-toplevel)"
AUDIT_OUTPUT=$(node scripts/audit-data-sync.mjs 2>&1 || true)

# Check for actual data integrity errors (duplicate IDs, orphan links)
HAS_DUPLICATES=$(echo "$AUDIT_OUTPUT" | grep -E '"duplicateIds":\s*\[[^\]]+\]' | grep -v '\[\]' || true)
HAS_ORPHANS=$(echo "$AUDIT_OUTPUT" | grep -E '"orphanLinks":\s*\[[^\]]+\]' | grep -v '\[\]' || true)

if [ -n "$HAS_DUPLICATES" ] || [ -n "$HAS_ORPHANS" ]; then
  echo "❌ Commit blocked: Data integrity error detected"
  echo "$AUDIT_OUTPUT"
  exit 1
fi

# Pre-existing drift is OK for code changes
echo "✅ Data audit passed (pre-existing drift not blocking code changes)"
exit 0
