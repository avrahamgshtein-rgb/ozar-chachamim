# Environment Configuration for אוצר חכמים (Next.js App)
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and should NOT be committed

# ══════════════════════════════════════════════════════════════════════════
# ── SUPABASE CONFIGURATION (Frontend Client) ───────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings > API
# ══════════════════════════════════════════════════════════════════════════

# Project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://ulluacifirzywhmzkvkr.supabase.co

# Anonymous public key (safe to expose, RLS enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ObxKLFsDTE41KoAMfMV1dw_Nu38ZI2C

# ══════════════════════════════════════════════════════════════════════════
# ── ERROR TRACKING (Sentry) ───────────────────────────────────────────────
# Setup: https://sentry.io → Create project → Get DSN (optional)
# ══════════════════════════════════════════════════════════════════════════

# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ══════════════════════════════════════════════════════════════════════════
# ── DEVELOPMENT SETTINGS ──────────────────────────────────────────────────
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ══════════════════════════════════════════════════════════════════════════
# ── SECURITY NOTES ────────────────────────────────────────────────────────
# ══════════════════════════════════════════════════════════════════════════
# ✅ SAFE to expose (RLS protects access):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# ❌ NEVER expose (backend only):
#   - SUPABASE_SERVICE_ROLE_KEY
#   - Database password
#   - JWT secret
#   - API keys (Anthropic, OpenAI, payment providers)
#
# .env.local is in .gitignore and will NOT be committed.
